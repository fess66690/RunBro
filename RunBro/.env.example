# Скопируйте этот файл в .env и при необходимости измените значения.
# Значения по умолчанию подходят для локальной разработки.

# Окружение: dev (по умолчанию) или prod
DJANGO_ENV=dev

# В production обязательно задайте длинный случайный секрет.
# Пример генерации: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-change-me-in-production

# Для production поставьте False.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- База данных ---
# sqlite (по умолчанию) или postgresql
DB_ENGINE=sqlite
# SQLITE_PATH=db.sqlite3

# POSTGRES_DB=runbro
# POSTGRES_USER=runbro
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# DB_CONN_MAX_AGE=60

# --- Локализация ---
LANGUAGE_CODE=ru-ru
TIME_ZONE=Europe/Moscow

# --- Почта ---
# В dev используется вывод писем в консоль.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=RunBro <noreply@runbro.local>

# --- Production / HTTPS ---
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
